
include: "rules/common.smk"
include: "rules/preprocess.smk"
include: "rules/negatives.smk"
include: "rules/train.smk"
include: "rules/interpret.smk"
include: "rules/report.smk"


# Stage targets are cumulative: each one runs the pipeline up to that stage.
PREPROCESS = [
    f"{OUTDIR}/config.snapshot.json",
    *[path for s in SAMPLES
      for path in (*signal_bw(s), *control_bw(s), f"{prefix(s)}.negatives.bed")],
]
TRAIN = PREPROCESS + per_fold("epochs.svg", "count_scatter.svg", "summary.txt") + [
    f"{OUTDIR}/report/metrics.tsv",
    f"{OUTDIR}/report/performance_distribution.svg",
    *[f"{OUTDIR}/report/count_pearson_vs_{c}.svg" for c in COVARIATES],
    f"{OUTDIR}/report/outliers.svg",
]
ATTRIBUTIONS = TRAIN + per_fold("attribution_profile.svg")
MOTIFS = ATTRIBUTIONS + per_fold("seqlet_lengths.svg", "motif_counts.svg") + [
    f"{OUTDIR}/report/motif_heatmap.svg",
]
MODISCO = MOTIFS + per_fold("modisco")
ALL = MODISCO + per_fold("marginalize")


rule all:
    input:
        ALL,
    default_target: True


rule preprocess:
    input:
        PREPROCESS,


rule train:
    input:
        TRAIN,


rule attributions:
    input:
        ATTRIBUTIONS,


rule motifs:
    input:
        MOTIFS,


rule modisco:
    input:
        MODISCO,
